# Variable names only. Copy to .env and fill in. Never commit .env.
DATABASE_URL=
PORT=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: one key for both models when using OpenRouter (D21)
OPENROUTER_API_KEY=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Model ids only. Example for OpenRouter: openrouter/openai/gpt-6-luna
STUDENT_MODEL=
CHECKER_MODEL=

# Sign-in limits per minute: per student (address Vercel forwards) and per Fly address (edge)
RATE_SIGNIN_PER_MIN=10
RATE_SIGNIN_EDGE_PER_MIN=120

# Optional: database pool size. Unset keeps the pgx default, max(4, CPUs).
DB_MAX_CONNS=
