  "concepts": [
    {
      "id": "00000000-0000-0000-0000-000000000101",
      "subject_id": "00000000-0000-0000-0000-0000000000a1",
      "name": "Exponential races",
      "claims": [
        {
          "id": "00000000-0000-0000-0000-000000020101",
          "concept_id": "00000000-0000-0000-0000-000000000101",
          "text": "If T1 ~ Exp(λ1) and T2 ~ Exp(λ2) are independent, then P(T1 < T2) = λ1/(λ1+λ2).",
          "source_id": "00000000-0000-0000-0000-0000000000b1",
          "locator": "p.2, Ex 3.2",
          "required": true
        },
        {
          "id": "00000000-0000-0000-0000-000000020102",
          "concept_id": "00000000-0000-0000-0000-000000000101",
          "text": "The minimum min(T1, T2) of two independent exponential times with rates λ1 and λ2 is Exp(λ1+λ2).",
          "source_id": "00000000-0000-0000-0000-0000000000b1",
          "locator": "p.3, Ex 3.3 (cont.)",
          "required": true
        },
        {
          "id": "00000000-0000-0000-0000-000000020103",
          "concept_id": "00000000-0000-0000-0000-000000000101",
          "text": "P(T1 < T2) is derived by conditioning on T1 = t, using P(T2 > t) = e^{-λ2 t}, and integrating against the density λ1 e^{-λ1 t}.",
          "source_id": "00000000-0000-0000-0000-0000000000b1",
          "locator": "p.10, Q6",
          "required": true
        },
        {
          "id": "00000000-0000-0000-0000-000000020104",
          "concept_id": "00000000-0000-0000-0000-000000000101",
          "text": "An Exp(λ) time has mean 1/λ, so a stated mean m converts to the rate 1/m.",
          "source_id": "00000000-0000-0000-0000-0000000000b1",
          "locator": "p.5, Q1",
          "required": true
        }
      ]
    },
    {
      "id": "00000000-0000-0000-0000-000000000102",
      "subject_id": "00000000-0000-0000-0000-0000000000a1",
      "name": "Superposition of Poisson processes",
      "claims": [
        {
          "id": "00000000-0000-0000-0000-000000020201",
          "concept_id": "00000000-0000-0000-0000-000000000102",
          "text": "If X(t) and Y(t) are independent Poisson processes with rates λ1 and λ2, then X(t)+Y(t) is a Poisson process with rate λ1+λ2.",
          "source_id": "00000000-0000-0000-0000-0000000000b1",
          "locator": "p.2, Ex 3.2",
          "required": true
        },
        {
          "id": "00000000-0000-0000-0000-000000020202",
          "concept_id": "00000000-0000-0000-0000-000000000102",
          "text": "In a Poisson process of rate λ, the count in time t is Poisson(λt): P(N(t)=k) = e^{-λt}(λt)^k/k!.",
          "source_id": "00000000-0000-0000-0000-0000000000b1",
          "locator": "p.2, Ex 3.2",
          "required": true
        },
        {
          "id": "00000000-0000-0000-0000-000000020203",
          "concept_id": "00000000-0000-0000-0000-000000000102",
          "text": "To get P(X(1)=k | X(1)+Y(1)=k), rewrite the event as {X(1)=k, Y(1)=0}, split it by independence, and divide by the Poisson(λ1+λ2) probability of the total.",
          "source_id": "00000000-0000-0000-0000-0000000000b1",
          "locator": "p.2, Ex 3.2",
          "required": true
        },
        {
          "id": "00000000-0000-0000-0000-000000020204",
          "concept_id": "00000000-0000-0000-0000-000000000102",
          "text": "For an independent random time T, P(X(T)=k) is found by integrating P(X(t)=k) against the density of T.",
          "source_id": "00000000-0000-0000-0000-0000000000b1",
          "locator": "p.2, Ex 3.2",
          "required": true
        }
      ]
    },
    {
      "id": "00000000-0000-0000-0000-000000000103",
      "subject_id": "00000000-0000-0000-0000-0000000000a1",
      "name": "Poisson counts and waiting times",
      "claims": [
        {
          "id": "00000000-0000-0000-0000-000000020301",
          "concept_id": "00000000-0000-0000-0000-000000000103",
          "text": "If customers arrive as a Poisson process with rate 20 per hour and each buys with probability 0.30, the number of sales N(t) is a Poisson process with rate 20·0.3 = 6, so E[N(8)] = 48 over an eight-hour day.",
          "source_id": "00000000-0000-0000-0000-0000000000b1",
          "locator": "p.5, Q1",
          "required": true
        },
        {
          "id": "00000000-0000-0000-0000-000000020302",
          "concept_id": "00000000-0000-0000-0000-000000000103",
          "text": "With N(t) Poisson of rate 6 per hour, P(N(1) >= 10) = 1 - sum_{n=0}^{9} e^{-6} 6^n / n! = 1 - 0.9161 = 0.0839.",
          "source_id": "00000000-0000-0000-0000-0000000000b1",
          "locator": "p.5, Q1",
          "required": true
        },
        {
          "id": "00000000-0000-0000-0000-000000020303",
          "concept_id": "00000000-0000-0000-0000-000000000103",
          "text": "The time Z1 until the first sale is exponentially distributed with mean 1/6 hour, so for a 10 a.m. opening the expected time of the first sale is 10:10 a.m.",
          "source_id": "00000000-0000-0000-0000-0000000000b1",
          "locator": "p.5, Q1",
          "required": true
        },
        {
          "id": "00000000-0000-0000-0000-000000020304",
          "concept_id": "00000000-0000-0000-0000-000000000103",
          "text": "Given N(1) = 6, P(N(2)-N(1) <= 2 | N(1) = 6) = P(N(1) <= 2) = sum_{n=0}^{2} e^{-6} 6^n / n! = 0.06197.",
          "source_id": "00000000-0000-0000-0000-0000000000b1",
          "locator": "p.5, Q1",
          "required": true
        }
      ]
    },
    {
      "id": "00000000-0000-0000-0000-000000000104",
      "subject_id": "00000000-0000-0000-0000-0000000000a1",
      "name": "Generators and transition matrices",
      "claims": [
        {
          "id": "00000000-0000-0000-0000-000000020401",
          "concept_id": "00000000-0000-0000-0000-000000000104",
          "text": "For the generator G = [[-1, 1], [4, -4]], the transition matrix is P(t) = e^{tG}.",
          "source_id": "00000000-0000-0000-0000-0000000000b1",
          "locator": "p.3, Ex 3.5",
          "required": true
        },
        {
          "id": "00000000-0000-0000-0000-000000020402",
          "concept_id": "00000000-0000-0000-0000-000000000104",
          "text": "For that G, P(t) has rows (4/5 + (1/5)e^{-5t}, 1/5 - (1/5)e^{-5t}) and (4/5 - (4/5)e^{-5t}, 1/5 + (4/5)e^{-5t}).",
          "source_id": "00000000-0000-0000-0000-0000000000b1",
          "locator": "p.3, Ex 3.5",
          "required": true
        },
        {
          "id": "00000000-0000-0000-0000-000000020403",
          "concept_id": "00000000-0000-0000-0000-000000000104",
          "text": "In the permanent disability model with states healthy (0), permanently disabled (1) and death (2), transition probabilities are estimated by solving Kolmogorov's forward equations numerically with Euler's forward method and step h = 0.1.",
          "source_id": "00000000-0000-0000-0000-0000000000b1",
          "locator": "p.7, Q3",
          "required": true
        },
        {
          "id": "00000000-0000-0000-0000-000000020404",
          "concept_id": "00000000-0000-0000-0000-000000000104",
          "text": "In the first Euler step p00(0.1) = 1 - 0.006 = 0.994 and p01(0.1) = 0.1·0.05 = 0.005; after the second step p01(0.2) = 0.00992 and p00(0.2) = 0.994^2 = 0.988036.",
          "source_id": "00000000-0000-0000-0000-0000000000b1",
          "locator": "p.7, Q3",
          "required": true
        }
      ]
    },
    {
      "id": "00000000-0000-0000-0000-000000000105",
      "subject_id": "00000000-0000-0000-0000-0000000000a1",
      "name": "Stationary distribution from balance equations",
      "claims": [
        {
          "id": "00000000-0000-0000-0000-000000020501",
          "concept_id": "00000000-0000-0000-0000-000000000105",
          "text": "The stationary distribution π of a finite continuous-time Markov chain with generator G is a row vector solving πG = 0.",
          "source_id": "00000000-0000-0000-0000-0000000000b1",
          "locator": "p.3, Ex 3.8",
          "required": true
        },
        {
          "id": "00000000-0000-0000-0000-000000020502",
          "concept_id": "00000000-0000-0000-0000-000000000105",
          "text": "πG = 0 only fixes π up to scale; π must also be normalised so its entries sum to 1.",
          "source_id": "00000000-0000-0000-0000-0000000000b1",
          "locator": "p.8, Q4",
          "required": true
        },
        {
          "id": "00000000-0000-0000-0000-000000020503",
          "concept_id": "00000000-0000-0000-0000-000000000105",
          "text": "The long-run proportion of time the chain spends in state i is π_i.",
          "source_id": "00000000-0000-0000-0000-0000000000b1",
          "locator": "p.11, Q7",
          "required": true
        },
        {
          "id": "00000000-0000-0000-0000-000000020504",
          "concept_id": "00000000-0000-0000-0000-000000000105",
          "text": "The sojourn time in state i is exponential with rate -g_ii (minus the diagonal entry of G), so its mean is 1/(-g_ii).",
          "source_id": "00000000-0000-0000-0000-0000000000b1",
          "locator": "p.3, Ex 3.8",
          "required": true
        }
      ]
    },
    {
      "id": "00000000-0000-0000-0000-000000000106",
      "subject_id": "00000000-0000-0000-0000-0000000000a1",
      "name": "Sojourn and hitting times",
      "claims": [
        {
          "id": "00000000-0000-0000-0000-000000020601",
          "concept_id": "00000000-0000-0000-0000-000000000106",
          "text": "In the chain of Ex 3.8 the sojourn time U1 of state 1 is Exp(3), so given X(0) = 1 the expected time until the first change of state is E[U1] = 1/3.",
          "source_id": "00000000-0000-0000-0000-0000000000b1",
          "locator": "p.3, Ex 3.8",
          "required": true
        },
        {
          "id": "00000000-0000-0000-0000-000000020602",
          "concept_id": "00000000-0000-0000-0000-000000000106",
          "text": "In the chain of Ex 3.8, (-G_{-4})^{-1} 1 = (1, 1, 1)^T, so starting in state 1 the expected time until the chain is in state 4 is 1.",
          "source_id": "00000000-0000-0000-0000-0000000000b1",
          "locator": "p.3, Ex 3.8",
          "required": true
        },
        {
          "id": "00000000-0000-0000-0000-000000020603",
          "concept_id": "00000000-0000-0000-0000-000000000106",
          "text": "In the chain of Q4 the sojourn time U1 of state 1 is Exp(2), so given X(0) = 1 the expected time until the first change of state is E[U1] = 1/2.",
          "source_id": "00000000-0000-0000-0000-0000000000b1",
          "locator": "p.8, Q4",
          "required": true
        },
        {
          "id": "00000000-0000-0000-0000-000000020604",
          "concept_id": "00000000-0000-0000-0000-000000000106",
          "text": "In the chain of Q4, (-G_{-4})^{-1} 1 = (4, 4, 3)^T, so starting in state 1 the expected time until the chain is in state 4 is 4.",
          "source_id": "00000000-0000-0000-0000-0000000000b1",
          "locator": "p.8, Q4",
          "required": true
        }
      ]
    },
    {
      "id": "00000000-0000-0000-0000-000000000107",
      "subject_id": "00000000-0000-0000-0000-0000000000a1",
      "name": "Birth-death recurrence criteria",
      "claims": [
        {
          "id": "00000000-0000-0000-0000-000000020701",
          "concept_id": "00000000-0000-0000-0000-000000000107",
          "text": "A birth-death process is positive recurrent, equivalently has a stationary distribution, if and only if the sum over n >= 1 of (λ_{n-1}···λ_0)/(β_n···β_1) is finite.",
          "source_id": "00000000-0000-0000-0000-0000000000b1",
          "locator": "p.3, Ex 3.11",
          "required": true
        },
        {
          "id": "00000000-0000-0000-0000-000000020702",
          "concept_id": "00000000-0000-0000-0000-000000000107",
          "text": "When that sum S is finite, π0 = 1/(1+S) and π_n = π0 (λ_{n-1}···λ_0)/(β_n···β_1) for n >= 1.",
          "source_id": "00000000-0000-0000-0000-0000000000b1",
          "locator": "p.4, Ex 3.14",
          "required": true
        },
        {
          "id": "00000000-0000-0000-0000-000000020703",
          "concept_id": "00000000-0000-0000-0000-000000000107",
          "text": "If that sum and the sum over n >= 1 of (β_n···β_1)/(λ_n···λ_1) both diverge, the process is null recurrent.",
          "source_id": "00000000-0000-0000-0000-0000000000b1",
          "locator": "p.4, Ex 3.11 (cont.)",
          "required": true
        },
        {
          "id": "00000000-0000-0000-0000-000000020704",
          "concept_id": "00000000-0000-0000-0000-000000000107",
          "text": "To classify a given birth-death process, simplify the rate products (they often telescope) and test the resulting series for convergence.",
          "source_id": "00000000-0000-0000-0000-0000000000b1",
          "locator": "p.4, Ex 3.11 (cont.)",
          "required": true
        }
      ]
    },
    {
      "id": "00000000-0000-0000-0000-000000000108",
      "subject_id": "00000000-0000-0000-0000-0000000000a1",
      "name": "Long-run behaviour of birth-death queues",
      "claims": [
        {
          "id": "00000000-0000-0000-0000-000000020801",
          "concept_id": "00000000-0000-0000-0000-000000000108",
          "text": "For the birth-death process of Q7 (λ_n = n+1 for n = 0, 1, 2 and λ_n = n for n >= 3, with β_n = 2n), adding the earlier balance equations gives -(n+1)π_{n+1} + 2(n+2)π_{n+2} = 0, so π_{n+2} = (n+1)/(2(n+2)) π_{n+1}.",
          "source_id": "00000000-0000-0000-0000-0000000000b1",
          "locator": "p.11, Q7",
          "required": true
        },
        {
          "id": "00000000-0000-0000-0000-000000020802",
          "concept_id": "00000000-0000-0000-0000-000000000108",
          "text": "In Q7, π0 = 0.51166 and the long-run proportion of time that the population is at least 3 is 1 - π0 - π1 - π2 = 0.1046.",
          "source_id": "00000000-0000-0000-0000-0000000000b1",
          "locator": "p.12, Q7 (cont.)",
          "required": true
        },
        {
          "id": "00000000-0000-0000-0000-000000020803",
          "concept_id": "00000000-0000-0000-0000-000000000108",
          "text": "In the one-barber shop with room for two customers, arrivals at rate 3 per hour and service mean 0.25 hours, the chain has states {0, 1, 2} with q10 = q21 = 4, and its stationary distribution is π = (16, 12, 9)/37.",
          "source_id": "00000000-0000-0000-0000-0000000000b1",
          "locator": "p.13, Q8",
          "required": true
        },
        {
          "id": "00000000-0000-0000-0000-000000020804",
          "concept_id": "00000000-0000-0000-0000-000000000108",
          "text": "In the barbershop chain, the average number of customers in the shop in the long run is π1 + 2π2 = 30/37, and the proportion of potential customers who enter the shop is the fraction of time the shop has 0 or 1 customers, π0 + π1 = 28/37.",
          "source_id": "00000000-0000-0000-0000-0000000000b1",
          "locator": "p.13, Q8",
          "required": true
        },
        {
          "id": "00000000-0000-0000-0000-000000020805",
          "concept_id": "00000000-0000-0000-0000-000000000108",
          "text": "If the barber works twice as fast, the barbershop stationary distribution is π = (64, 24, 9)/97, the entering proportion becomes 88/97, and business grows by (88/97)/(28/37) - 1 = 19.88%.",
          "source_id": "00000000-0000-0000-0000-0000000000b1",
          "locator": "p.13, Q8",
          "required": true
        }
      ]
    }
  ]
}
