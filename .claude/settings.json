{
  "permissions": {
    "allow": [
      "Bash(go build *)", "Bash(go test *)", "Bash(go vet *)", "Bash(go mod *)", "Bash(go get *)",
      "Bash(make *)", "Bash(docker compose *)", "Bash(npm *)", "Bash(npx *)",
      "Bash(git status *)", "Bash(git diff *)", "Bash(git log *)", "Bash(git add *)", "Bash(git commit *)",
      "Bash(git switch *)", "Bash(git fetch *)", "Bash(git push *)", "Bash(gh pr create *)", "Bash(gh pr view *)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.local)"]
  },
  "hooks": {
    "PreToolUse": [
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.py", "args": []}]},
      {"matcher": "Edit|Write", "hooks": [{"type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.py", "args": []}]}
    ]
  }
}
